# ======================================================================
# Nasande — .env.production.example  (template pour serveur de PRODUCTION)
# Architecture cible : hébergement mutualisé Linux + Apache + MySQL
# (pas de Redis ni de Meilisearch en prod : Scout en driver "database",
#  cache "file", queue "database", session "database")
#
# Usage :
#   1. cp .env.production.example .env   (sur le serveur)
#   2. Renseigner CHAQUE valeur (rien n'est laissé à deviner en prod)
#   3. php artisan key:generate --force   (régénère APP_KEY de façon sûre)
#   4. Ne jamais commiter ce fichier rempli. .env est déjà dans .gitignore.
# ======================================================================

# ─── Application ──────────────────────────────────────────────────────
APP_NAME=nasande
APP_ENV=production
APP_DEBUG=false                 # OBLIGATOIRE false en prod
APP_KEY=                        # généré par `php artisan key:generate`
APP_URL=https://nasande.cg
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_TIMEZONE=Africa/Brazzaville

# ─── Base de données (MySQL mutualisé) ───────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1               # souvent 'localhost' chez l'hébergeur
DB_PORT=3306
DB_DATABASE=nasande_prod
DB_USERNAME=nasande_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Connexion dédiée à la queue (même base OK, sinon séparer)
DB_QUEUE_CONNECTION=mysql

# ─── Queue / Cache / Session (sans Redis en prod) ────────────────────
QUEUE_CONNECTION=database
CACHE_STORE=file
CACHE_PREFIX=nasande_
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# ─── Recherche (Scout driver "database" — pas de Meilisearch) ────────
SCOUT_DRIVER=database
SCOUT_QUEUE=false               # indexation synchrone (DB le permet)
SCOUT_PREFIX=

# ─── E-mail (SMTP transactionnel ; pas Mailpit en prod) ───────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.nasande.cg       # ou le SMTP de l'hébergeur
MAIL_PORT=587
MAIL_USERNAME=noreply@nasande.cg
MAIL_PASSWORD=CHANGE_ME_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@nasande.cg
MAIL_FROM_NAME="nasande"

# ─── Stockage ─────────────────────────────────────────────────────────
FILESYSTEM_DISK=public          # + `php artisan storage:link` en post-deploy

# ─── Enrichissement IA (DeepSeek primaire / NVIDIA secondaire) ───────
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=CHANGE_ME_DEEPSEEK_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_CHAT=deepseek-chat
DEEPSEEK_MODEL_REASONING=deepseek-reasoner

# Recherche web pour l'enrichissement (ex: Brave Search)
WEBSEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=CHANGE_ME_BRAVE_KEY

# Fournisseur secondaire (NVIDIA) — activé côté code si DEEPSEEK tombe
NVIDIA_API_KEY=
NVIDIA_BASE_URL=

EMBEDDINGS_PROVIDER=none
OPENAI_API_KEY=

# ─── Paiements mobiles (Airtel Money / MTN MoMo) ─────────────────────
# Les providers sont présents (AirtelMoneyProvider / MtnMomoProvider) — stubs USSD.
# Les noms ci-dessous sont ceux lus par config/commerce.php.
AIRTEL_MONEY_ENABLED=true
AIRTEL_MONEY_MERCHANT_CODE=
AIRTEL_MONEY_WEBHOOK_SECRET=
MTN_MOMO_ENABLED=true
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_WEBHOOK_SECRET=
MTN_MOMO_ENVIRONMENT=sandbox   # passer en "live" après validation

# ─── Analytics (Google Analytics 4) ─────────────────────────────────
# Measurement ID GA4, ex: G-XXXXXXXXXX (laisser vide pour désactiver)
ANALYTICS_GA4_ID=

# ─── Observabilité / Logs ─────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily                 # rotation quotidienne en prod
LOG_LEVEL=info                  # pas "debug" en prod
LOG_DEPRECATIONS_CHANNEL=null

# ─── Sécurité ─────────────────────────────────────────────────────────
# Les headers HSTS/CSP/X-Frame-Options sont posés par public/.htaccess
# (voir public/.htaccess). Ne pas activer le debug bar en prod.
TELESCOPE_ENABLED=false
